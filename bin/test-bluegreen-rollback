#!/usr/bin/env bash
# CI-only: exercise the reverse transition after a completed Green match.
set -Eeuo pipefail

if [[ "${CAW_BLUEGREEN_CI:-}" != "1" || "${COMPOSE_PROJECT_NAME:-}" != "caw-ci" ]]; then
  echo "FAIL: Blue/Green rollback rehearsal requires the isolated CI project" >&2
  exit 1
fi

cd "$(dirname "$0")/.."
base=(docker compose -f deploy/compose.yml)
candidate=(docker compose -f deploy/compose.yml -f deploy/compose.bluegreen.yml -f deploy/compose.bluegreen.ci.yml)
green_metrics="$("${candidate[@]}" exec -T server-green \
  curl --fail --silent http://127.0.0.1:8080/metrics)"
active_sockets="$(printf '%s\n' "$green_metrics" | awk '$1 == "caw_sockets" { print $2 }')"
if [[ "$active_sockets" != "0" ]]; then
  echo "FAIL: refuse to stop Green while clients remain connected" >&2
  exit 1
fi

# Create a synthetic room ON GREEN, to prove the old slot can recover newer data.
room_code="$(curl --fail --silent --show-error \
  -H 'Content-Type: application/json' -d '{"language":"de"}' \
  http://127.0.0.1:8080/api/sessions |
  python3 -c 'import json,sys; print(json.load(sys.stdin)["code"])')"
if [[ ! "$room_code" =~ ^[A-HJKMNP-Z2-9]{6}$ ]]; then
  echo "FAIL: invalid synthetic room returned by Green" >&2
  exit 1
fi
expected_rooms="$("${candidate[@]}" exec -T server-green \
  curl --fail --silent http://127.0.0.1:8080/metrics |
  awk '$1 == "caw_sessions" { print $2 }')"
if [[ ! "$expected_rooms" =~ ^[1-9][0-9]*$ ]]; then
  echo "FAIL: cannot determine Green's room count" >&2
  exit 1
fi

# Only one process may own rooms: stop Green before starting Blue.
"${candidate[@]}" stop -t 30 server-green
green_id="$("${candidate[@]}" ps -aq server-green)"
if [[ -z "$green_id" ||
      "$(docker inspect --format '{{.State.Running}}' "$green_id")" != "false" ]]; then
  echo "FAIL: Green did not stop; Blue stays inactive" >&2
  exit 1
fi
"${base[@]}" up --no-deps --no-build --detach --wait --wait-timeout 90 server
restored_rooms="$("${base[@]}" exec -T server \
  curl --fail --silent http://127.0.0.1:8080/metrics |
  awk '$1 == "caw_sessions" { print $2 }')"
if [[ "$restored_rooms" != "$expected_rooms" ]]; then
  echo "FAIL: Blue missed saved rooms; Caddy still routes to stopped Green" >&2
  exit 1
fi

# Recreate CI Caddy with the normal upstream default, never restart Redis/Postgres.
"${base[@]}" up --no-deps --no-build --force-recreate \
  --detach --wait --wait-timeout 90 caddy
test "$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
  "http://127.0.0.1:8080/api/sessions/$room_code")" = "200"
echo "PASS: rollback recovered Green-created room on Blue through CI Caddy"
