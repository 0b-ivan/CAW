#!/usr/bin/env bash
# CI-only, destructive-to-the-TEST-STACK rehearsal. Never run on Hetzner.
set -Eeuo pipefail

if [[ "${CAW_BLUEGREEN_CI:-}" != "1" || "${COMPOSE_PROJECT_NAME:-}" != "caw-ci" ]]; then
  echo "FAIL: Blue/Green takeover rehearsal requires the isolated CI project" >&2
  exit 1
fi

cd "$(dirname "$0")/.."
base=(docker compose -f deploy/compose.yml)
candidate=(docker compose -f deploy/compose.yml -f deploy/compose.bluegreen.yml -f deploy/compose.bluegreen.ci.yml)

# A candidate may receive traffic only if it restored every previously
# known room. Count only: never print room codes, tickets or private snapshots.
expected_rooms="$("${base[@]}" exec -T server \
  curl --fail --silent http://127.0.0.1:8080/metrics |
  awk '$1 == "caw_sessions" { print $2 }')"
if [[ ! "$expected_rooms" =~ ^[1-9][0-9]*$ ]]; then
  echo "FAIL: cannot establish the active slot's room count" >&2
  exit 1
fi

# Freeze the old game thread first. HTTP 200 confirms even in-flight Redis
# writes; a 503 leaves Blue as the only server and forbids takeover.
"${base[@]}" exec -T server \
  curl --fail --silent --show-error --max-time 10 --request POST \
  http://127.0.0.1:8080/internal/handoff/quiesce | grep -qx '{"status":"persisted"}'
ready_status="$("${base[@]}" exec -T server \
  curl --silent --output /dev/null --write-out '%{http_code}' \
  http://127.0.0.1:8080/readyz)"
if [[ "$ready_status" != 503 ]]; then
  echo "FAIL: Blue accepted game traffic after quiesce" >&2
  exit 1
fi
# The active owner must be completely stopped before Green can load its rooms.
curl --fail --silent --show-error http://127.0.0.1:8080/healthz >/dev/null
"${base[@]}" stop -t 30 server
blue_id="$("${base[@]}" ps -aq server)"
if [[ -z "$blue_id" ]]; then
  echo "FAIL: cannot inspect the stopped Blue container" >&2
  exit 1
fi
if [[ "$(docker inspect --format '{{.State.Running}}' "$blue_id")" != "false" ]]; then
  echo "FAIL: Blue is still running; refusing to activate Green" >&2
  exit 1
fi

# Recreate only Green, never Redis, Postgres, Caddy, or the stopped Blue.
"${candidate[@]}" up --no-deps --no-build --force-recreate \
  --detach --wait --wait-timeout 90 server-green
curl --fail --silent --show-error http://127.0.0.1:18082/readyz |
  grep -qx ready
restored_rooms="$("${candidate[@]}" exec -T server-green \
  curl --fail --silent http://127.0.0.1:8080/metrics |
  awk '$1 == "caw_sessions" { print $2 }')"
if [[ "$restored_rooms" != "$expected_rooms" ]]; then
  echo "FAIL: Green did not restore every room; Caddy remains unchanged" >&2
  exit 1
fi

# This container restart is deliberate in CI; production requires tested
# in-place Caddy reload with stream_close_delay and a fenced ownership handoff.
"${candidate[@]}" up --no-deps --no-build --force-recreate \
  --detach --wait --wait-timeout 90 caddy
curl --fail --silent --show-error http://127.0.0.1:8080/healthz |
  grep -qx ok
echo "PASS: stopped Blue, restored Green, routed CI Caddy to Green"
