#!/bin/sh
# Check owned code and preserve the byte-comparable upstream formatting.
set -eu
cd "$(dirname "$0")/.."
find server/src server/tests -type f \( -name '*.cpp' -o -name '*.h' \) \
  -exec clang-format --dry-run --Werror {} +
clang-tidy -p "${1:-build}" server/src/main.cpp server/src/config.cpp server/src/log.cpp \
  server/src/net/Messages.cpp server/src/net/Metrics.cpp server/src/store/Health.cpp
