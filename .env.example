# Copy to deploy/.env (Compose project directory). Use a fresh URL-safe password.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-value
PUBLIC_URL=http://localhost:8080
CADDY_ADDRESS=:80
# Production on caw.obivan.org (DNS A/AAAA record to the server first):
# CADDY_ADDRESS=caw.obivan.org
# PUBLIC_URL=https://caw.obivan.org
# HTTP_PORT=80
# HTTPS_PORT=443
HTTP_PORT=8080
HTTPS_PORT=8443
SESSION_TTL_HOURS=24
LOG_LEVEL=info
# Room lookups and game sockets per minute and client address; creating rooms: a tenth.
RATE_LIMIT_PER_MINUTE=60
# Outside Compose, the server also requires:
# DATABASE_URL=postgresql://caw:password@localhost:5432/caw
# REDIS_URL=tcp://localhost:6379
# PORT=8080
