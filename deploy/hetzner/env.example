# Copy to deploy/.env. Do not commit populated secrets.
# Use: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_HEX
PUBLIC_URL=https://caw.obivan.org
CADDY_ADDRESS=:80
# Existing cloudflared on the host routes to http://127.0.0.1:18081.
# Change both this port and the existing Tunnel route if the port is occupied.
CAW_ORIGIN_PORT=18081
SESSION_TTL_HOURS=24
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=info
# Do not duplicate the existing cloudflared token or add a second connector.
# CAW_VERSION is set only after a verified release.
